# Copy to .env. Never commit .env or put these secrets in frontend variables.
# REQUIRED for the API/UI: keys you create yourself, mapped to workspace owners.
# Generate a key: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Example: MEDIACHAIN_API_KEYS='{"your-generated-key":"local-user"}'
# Enter your generated key in the frontend's workspace connection dialog.
MEDIACHAIN_API_KEYS={}

# OPTIONAL: one provider key shared by chat and vision adapters.
# This is the only external AI API key currently used by this project.
# Use a compatible chat-completions endpoint and its exact model identifiers.
# Leave blank for local text retrieval. Local model servers may need no key.
# Local example: http://localhost:8001/v1
# From Docker to a host model server: http://host.docker.internal:8001/v1
MODEL_BASE_URL=
MODEL_API_KEY=
CHAT_MODEL=
VISION_MODEL=

# OPTIONAL local models: no API keys needed for public model downloads.
# Set SPEECH_MODEL=base to enable local audio transcription (FFmpeg required).
SPEECH_MODEL=
# Example: sentence-transformers/all-MiniLM-L6-v2 (384 dimensions).
# Blank uses built-in lexical retrieval. First use downloads model weights.
EMBEDDING_MODEL=
EMBEDDING_REVISION=main
EMBEDDING_DIMENSIONS=384

# REQUIRED only for docker compose: choose a strong PostgreSQL password.
POSTGRES_PASSWORD=
# OPTIONAL external services. Blank uses SQLite, memory vectors/cache/local jobs.
# docker compose supplies these three URLs automatically for its own services.
# DATABASE_URL=postgresql://mediachain:password@localhost:5432/mediachain
DATABASE_URL=
# REDIS_URL=redis://localhost:6379/0
REDIS_URL=
# QDRANT_URL=http://localhost:6333
QDRANT_URL=
# Qdrant Cloud API-key authentication is not currently wired into this adapter.
# No AWS, payment, email, or other provider keys are needed by this version.
MEDIACHAIN_DATA_DIR=.mediachain
# Built frontend folder, relative to the project root when starting locally.
MEDIACHAIN_FRONTEND_DIR=frontend/dist
