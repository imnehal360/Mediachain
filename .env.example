# Copy to .env. Never commit .env or put these secrets in frontend variables.
# REQUIRED for the API/UI: keys you create yourself, mapped to workspace owners.
# Generate a key: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Example: MEDIACHAIN_API_KEYS='{"your-generated-key":"local-user"}'
# Enter your generated key in the frontend's workspace connection dialog.
MEDIACHAIN_API_KEYS={}
# Docker enables this automatically so missing hosted infrastructure fails at startup.
MEDIACHAIN_REQUIRE_HOSTED_SERVICES=false
# Comma-separated public frontend origins and hostnames. Leave origins blank when the
# frontend is served by this API. Set the actual deployment hostname before launch.
MEDIACHAIN_ALLOWED_ORIGINS=
MEDIACHAIN_TRUSTED_HOSTS=localhost,127.0.0.1
MEDIACHAIN_RATE_LIMIT_PER_MINUTE=120

# OPTIONAL: one hosted provider key shared by chat and vision adapters.
# Hugging Face example (fine-grained token with "Make calls to Inference Providers"):
# MODEL_BASE_URL=https://router.huggingface.co/v1
# MODEL_API_KEY=hf_replace_me
# CHAT_MODEL=Qwen/Qwen2.5-7B-Instruct-1M
# VISION_MODEL=CohereLabs/aya-vision-32b:cohere
# The Hugging Face OpenAI-compatible endpoint supports chat and conversational vision only.
# Leave all values blank for extractive answers without hosted model calls.
MODEL_BASE_URL=
MODEL_API_KEY=
CHAT_MODEL=
VISION_MODEL=
OCR_MODEL=
OCR_BASE_URL=
OCR_API_KEY=
OCR_MAX_PAGES=200

# Set SPEECH_PROVIDER=huggingface for native Hugging Face Inference Providers ASR. In that mode,
# SPEECH_BASE_URL stays blank and SPEECH_API_KEY contains the Hugging Face token.
SPEECH_PROVIDER=
SPEECH_HF_PROVIDER=auto
SPEECH_MODEL=
SPEECH_MODEL_REVISION=configured
SPEECH_BASE_URL=
SPEECH_API_KEY=
DIARIZATION_MODEL=
DIARIZATION_BASE_URL=
DIARIZATION_API_KEY=
# Hosted OpenAI-compatible embeddings endpoint. If EMBEDDING_BASE_URL is blank,
# Set EMBEDDING_PROVIDER=huggingface for native hosted feature extraction. Use the actual output
# dimensions of the selected model. Leaving EMBEDDING_MODEL blank uses the lexical baseline.
EMBEDDING_PROVIDER=
EMBEDDING_HF_PROVIDER=hf-inference
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_REVISION=main
EMBEDDING_DIMENSIONS=384

# Optional second model call that rejects answers not fully supported by cited evidence.
VERIFY_GROUNDED_ANSWERS=false
VERIFIER_MODEL=
VERIFIER_BASE_URL=
VERIFIER_API_KEY=

# Hosted infrastructure. Docker Compose does not start local service containers.
# Use the TLS URLs supplied by your managed providers.
DATABASE_URL=
REDIS_URL=
QDRANT_URL=
QDRANT_API_KEY=
# Hosted S3 or S3-compatible storage for original media. The app uses /data only as an
# ephemeral decode cache. AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY may be omitted when
# the hosting platform supplies an IAM workload role.
S3_BUCKET=
S3_PREFIX=mediachain
S3_ENDPOINT_URL=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MEDIACHAIN_DATA_DIR=/data
# Built frontend folder inside the production container.
MEDIACHAIN_FRONTEND_DIR=frontend/dist
