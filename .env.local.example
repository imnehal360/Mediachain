# Copy this file to .env. No-auth mode accepts requests only from this computer.
MEDIACHAIN_DISABLE_AUTH=true
MEDIACHAIN_LOCAL_OWNER=local-user
MEDIACHAIN_API_KEYS={}
MEDIACHAIN_REQUIRE_HOSTED_SERVICES=false
MEDIACHAIN_ALLOWED_ORIGINS=
MEDIACHAIN_TRUSTED_HOSTS=localhost,127.0.0.1
MEDIACHAIN_RATE_LIMIT_PER_MINUTE=120
MEDIACHAIN_REMOTE_MAX_BYTES=524288000
MEDIACHAIN_REMOTE_MAX_DURATION_SECONDS=14400
MEDIACHAIN_FRAME_INTERVAL=5
MEDIACHAIN_MAX_FRAMES=120
MEDIACHAIN_SPEECH_TIMEOUT=7200
MEDIACHAIN_AGENT_MAX_STEPS=6
MEDIACHAIN_AGENT_MAX_TOOL_CALLS=3
MEDIACHAIN_AGENT_TIMEOUT=90
MEDIACHAIN_AGENT_MAX_TOKENS=50000
MEDIACHAIN_AGENT_MAX_OBSERVATION_CHARS=12000
MEDIACHAIN_DATA_DIR=.mediachain
MEDIACHAIN_FRONTEND_DIR=frontend/dist
OLLAMA_NO_CLOUD=true

MODEL_BASE_URL=http://127.0.0.1:11434/v1
MODEL_API_KEY=
CHAT_MODEL=qwen3-vl:2b-instruct
VISION_MODEL=qwen3-vl:2b-instruct
OCR_MODEL=qwen3-vl:2b-instruct
OCR_BASE_URL=http://127.0.0.1:11434/v1
OCR_API_KEY=
OCR_MAX_PAGES=200

SPEECH_PROVIDER=
SPEECH_MODEL=base
SPEECH_MODEL_REVISION=default
SPEECH_BASE_URL=
SPEECH_API_KEY=

EMBEDDING_PROVIDER=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_REVISION=main
EMBEDDING_DIMENSIONS=384
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

VERIFY_GROUNDED_ANSWERS=false
DATABASE_URL=
REDIS_URL=
QDRANT_URL=
QDRANT_API_KEY=
S3_BUCKET=
